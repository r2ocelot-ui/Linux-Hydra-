# Paquetes de gaming y compatibilidad Windows
# Nota: paquetes :i386 y otros de terceros (Discord, Steam-libs) se instalan
# vía scripts/setup-gaming.sh tras la instalación, ya que requieren habilitar
# la arquitectura i386 y/o repositorios externos.

# Lutris (gestor de juegos)
lutris

# Wine y compatibilidad Windows
wine
winetricks

# MangoHud (overlay de rendimiento)
mangohud

# Vulkan
vulkan-tools
mesa-vulkan-drivers

# GameMode (optimización de rendimiento)
gamemode
libgamemode0
libgamemodeauto0

# Herramientas de GPU
mesa-utils
vainfo
vdpauinfo

# Joystick y gamepads
jstest-gtk
joystick

# Emuladores populares
retroarch
libretro-core-info
