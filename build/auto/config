#!/bin/bash
# live-build auto/config — opciones base del sistema
set -e

lb config noauto \
    --architectures amd64 \
    --mode debian \
    --distribution bookworm \
    --archive-areas "main contrib non-free non-free-firmware" \
    --apt-indices false \
    --apt-recommends true \
    --apt-source-archives false \
    --bootappend-live "boot=live components quiet splash locale=es_ES.UTF-8 keyboard-layouts=es" \
    --bootappend-live-failsafe "boot=live components memtest noapic noapm nodma nomce nolapic nomodeset nosmp nosplash vga=normal" \
    --bootloader grub-efi \
    --binary-image iso-hybrid \
    --debian-installer none \
    --image-name "hydra-os-amd64" \
    --iso-application "Hydra OS" \
    --iso-preparer "Hydra OS Team" \
    --iso-publisher "Hydra OS" \
    --iso-volume "HYDRA_OS_1" \
    --memtest none \
    --win32-loader false \
    --zsync false \
    "${@}"
